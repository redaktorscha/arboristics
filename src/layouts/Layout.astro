---
import HeadBase from '../components/HeadBase.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <HeadBase title={title} />
  <body>
    <div
      class="container mx-auto px-4 grid grid-rows-[auto_1fr_auto] justify-items-center min-h-screen"
    >
    </div>
    <slot />
  </body>
</html>
